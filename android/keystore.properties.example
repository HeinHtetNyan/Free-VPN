# Copy this file to android/keystore.properties (gitignored — never commit
# the real values or the keystore file itself) once android/release.keystore
# exists. Without this file, release builds fall back to being unsigned
# (debug builds are unaffected — they always use the committed debug.keystore).

storePassword=your-real-store-password
keyPassword=your-real-key-password
keyAlias=sy-vpn-upload
storeFile=release.keystore
