<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed to query ConnectivityManager (VpnConnectionManager.isRunning())
         — reading network state, not modifying it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- VpnService itself doesn't require a manifest permission beyond
         BIND_VPN_SERVICE on the service declaration below; the user grants
         VPN access via the system prompt triggered by VpnService.prepare(). -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AmneziaWG's GoBackend drives this exact service class internally
             (see vpn/VpnConnectionManager.kt) — it is not a service we
             implement ourselves. Lives on AbstractBackend, not GoBackend
             itself, in this library. -->
        <service
            android:name="org.amnezia.awg.backend.AbstractBackend$VpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>
</manifest>
