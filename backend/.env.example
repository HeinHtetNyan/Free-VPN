# Copy to backend/.env on the deploy host (gitignored — never commit real
# values). BIND_HOST is set directly in docker-compose.yml, not here — do
# not override it to anything other than 127.0.0.1 in production; this
# container runs with network_mode: host, so binding wider than that puts
# the API directly on the VPS's public IP with no Cloudflare Tunnel in front
# of it.

DB_PATH=/data/vpnapp.db
# awg0 (AmneziaWG, DPI-resistant — see docs/ARCHITECTURE.md "Censorship
# resistance") if infra/scripts/setup-amnezia-interface.sh has been run;
# wg0 (plain kernel WireGuard, via infra/scripts/setup-central-server.sh)
# otherwise.
WG_INTERFACE=awg0
# MUST match WG_INTERFACE's own `ip addr` subnet (see
# internal/servers/peer_store.go: AllocateIP hands out addresses the
# interface doesn't route otherwise) — 10.67 for awg0
# (infra/scripts/setup-amnezia-interface.sh's default AWG_SUBNET), 10.66 for
# wg0 (infra/scripts/setup-central-server.sh's default WG_SUBNET).
WG_SUBNET_BASE=10.67
# Central server's WireGuard public key — printed by
# infra/scripts/setup-central-server.sh (wg0) or
# infra/scripts/setup-amnezia-interface.sh (awg0) when it was run.
SERVER_PUBLIC_KEY=4b3P37J2ZE3Hj2xDyCFPsFUWrJM+DZRCmE//5MRXdEo=
PORT=8080

# Gates POST /admin/friends[/revoke] (see internal/auth.RequireAdminToken) —
# only the Activation-Licenses admin backend's "VPN Friends" tab should ever
# call these. Generate with e.g. `openssl rand -base64 32`. Leave unset to
# disable the admin routes entirely (every request gets 503).
VPN_ADMIN_TOKEN=

# AmneziaWG obfuscation params — all-or-nothing (see
# backend/internal/servers/amnezia.go: AmneziaParamsFromEnv). Leave every
# AWG_* var unset for plain WireGuard (WG_INTERFACE=wg0). Generate a real,
# matched set with infra/scripts/generate-amnezia-params.sh — do NOT hand-edit
# these or regenerate them casually: every currently-issued client config
# must carry the exact same values the server interface (WG_INTERFACE) was
# configured with, or handshakes silently fail.
AWG_JC=
AWG_JMIN=
AWG_JMAX=
AWG_S1=
AWG_S2=
AWG_S3=
AWG_S4=
AWG_H1=
AWG_H2=
AWG_H3=
AWG_H4=
AWG_I1=
AWG_I2=
AWG_I3=
AWG_I4=
AWG_I5=
